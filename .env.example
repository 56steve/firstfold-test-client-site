# The blog token from admin.firstfold.io -> Clients -> this client -> "Their website's blog token".
# Server-side only: never prefix it with NEXT_PUBLIC_.
FIRSTFOLD_SITE_TOKEN=

# The Firstfold platform. Leave as is unless testing against another environment.
FIRSTFOLD_API_ORIGIN=https://app.firstfold.io

# This website's own address, with no trailing slash. Used for canonical links, the sitemap and schema.org data.
# Leave empty on Vercel until a real domain is connected: the production *.vercel.app address is used instead.
SITE_URL=

